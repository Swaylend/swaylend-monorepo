# =============================================================================
# Network
# =============================================================================

# 'mainnet' | 'testnet' | 'devnet' — verified against chain name on every run.
NETWORK=testnet

# Fuel RPC GraphQL endpoint.
# mainnet:  https://mainnet.fuel.network/v1/graphql
# testnet:  https://testnet.fuel.network/v1/graphql
PROVIDER_URL=https://testnet.fuel.network/v1/graphql

# =============================================================================
# Contracts
# =============================================================================

# Proxy contract (this is the address users + the dapp call into).
PROXY_CONTRACT_ID=

# Underlying market implementation behind the proxy.
TARGET_CONTRACT_ID=

# Pyth oracle contract (mock on testnet, real on mainnet).
PYTH_CONTRACT_ID=

# Token contract (only used by mint-tokens / deploy-tokens scripts).
TOKEN_CONTRACT_ID=

# =============================================================================
# Signer — EOA (used for permissionless scripts and read paths)
# =============================================================================

# Private key for a normal Fuel wallet. Required for:
#  - all permissionless scripts (fill-reserves, deploy-*, mint-tokens)
#  - signing the inner-signer leg of Bako multisig flows (in single-signer
#    test vaults). For production multisigs, signers approve via the Bako web UI.
SIGNING_KEY=

# =============================================================================
# Bako Safe (multisig) — used for owner-only scripts
# =============================================================================

# The Bako vault address (predicate B256). Created via https://safe.bako.global
# Testnet test vault: 0x5Ae1d20f72ebbc559571788195E326De3Ea41419499420B366Fc5a30948e68B9
BAKO_WALLET_ADDRESS=0x5Ae1d20f72ebbc559571788195E326De3Ea41419499420B366Fc5a30948e68B9

# API token for the Bako off-chain co-signing service.
# Get from https://safe.bako.global (CLI / API keys section)
BAKO_TOKEN_API=

# Bako's hosted signature-aggregation URL. Leave default unless self-hosting.
# BAKO_API_URL=https://api.bako.global
